amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping {
  ["harper"] = (Builtins.harper) {
    exclude = List(".gitignore", "hk.pkl")
  }

  ["mise"] = Builtins.mise
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["shellcheck"] = Builtins.shellcheck
  ["taplo"] = Builtins.taplo
  ["taplo_format"] = Builtins.taplo_format
  ["trailing_whitespace"] = Builtins.trailing_whitespace
}

steps = linters

hooks {
  ["check"] {
    steps = linters
  }

  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
      ["harper_commit_message"] = Builtins.harper_commit_message
    }
  }
}
